---
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getSite } from '../utils/consts';
import { localeTags } from '../i18n/config';
import { resolveLocale, useTranslations } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
	image?: ImageMetadata;
	noindex?: boolean;
}

const locale = resolveLocale(Astro);
const t = useTranslations(locale);

const site = await getSite();
const {
	title = site.title,
	description = t('site.description'),
	image,
	noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang={localeTags[locale]}>
    <head>
        <BaseHead title={title} description={description} image={image} noindex={noindex} />
        <Font cssVariable="--font-main" preload />
        <Font cssVariable="--font-header" preload />
        <Font cssVariable="--font-title" preload />
        <script is:inline>
            (() => {
                const root = document.documentElement;
                const apply = () => {
                    const rem = parseFloat(getComputedStyle(root).fontSize) || 16;
                    const fluid = 0.123 * root.clientWidth;
                    const cell = Math.floor(Math.min(Math.max(2.625 * rem, fluid), 5.625 * rem));
                    if (cell > 0) root.style.setProperty('--grid-cell', cell + 'px');

                    const hero = document.querySelector('[data-hero]');
                    const stack = hero && hero.firstElementChild;
                    if (!stack) return;
                    const header = document.querySelector('.site-header');
                    const headerCells = Math.round((header ? header.offsetHeight : cell) / cell);
                    const free = root.clientHeight - headerCells * cell - stack.offsetHeight;
                    const target = (headerCells + Math.max(0, Math.round(free / 2 / cell))) * cell;
                    const top = hero.getBoundingClientRect().top + window.scrollY;
                    hero.style.paddingTop = Math.max(0, target - top) + 'px';
                };
                apply();
                addEventListener('resize', apply, { passive: true });
                addEventListener('DOMContentLoaded', apply);
                addEventListener('load', apply);
                if (document.fonts) document.fonts.ready.then(apply);
            })();
        </script>
    </head>
    <body>
        <a class="skip-link" href="#main">{t('site.skipToContent')}</a>
        <Header />
        <main id="main" class="content-shell">
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    .content-shell {
        padding-top: calc(var(--grid-cell) * 2);
    }

    @media (max-width: 860px) {
        .content-shell {
            padding-top: calc(var(--grid-cell) * 3);
        }
    }

    .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1rem;
        background: var(--color-surface);
        color: var(--color-ink);
        border: 1px solid var(--color-border);
        border-radius: 0 0 12px 0;
    }

    .skip-link:focus {
        left: 0;
    }
</style>
