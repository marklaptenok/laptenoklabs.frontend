---
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getSite } from '../utils/consts';
import { localeTags } from '../i18n/config';
import { resolveLocale, useTranslations } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
	image?: ImageMetadata;
}

const locale = resolveLocale(Astro);
const t = useTranslations(locale);

const site = await getSite();
const {
	title = site.title,
	description = t('site.description'),
	image,
} = Astro.props;
---

<!doctype html>
<html lang={localeTags[locale]}>
    <head>
        <BaseHead title={title} description={description} image={image} />
        <Font cssVariable="--font-main" preload />
        <Font cssVariable="--font-header" preload />
        <Font cssVariable="--font-title" preload />
    </head>
    <body>
        <a class="skip-link" href="#main">{t('site.skipToContent')}</a>
        <Header />
        <main id="main" class="content-shell">
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    .content-shell {
        padding-top: max(calc(var(--grid-cell) * 1), 4.5rem);
    }

    @media (max-width: 860px) {
        .content-shell {
            padding-top: max(calc(var(--grid-cell) * 2), 6.5rem);
        }
    }

    .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1rem;
        background: var(--color-surface);
        color: var(--color-ink);
        border: 1px solid var(--color-border);
        border-radius: 0 0 12px 0;
    }

    .skip-link:focus {
        left: 0;
    }
</style>
