---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import CvButton from '../../../components/CvButton.astro';
import RichText from '../../../components/RichText.astro';
import { entryLocale, entrySlug, localeUrl, resolveLocale, useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
	const people = await getCollection('cv');
	return people.map((person) => ({
		params: { locale: entryLocale(person.id), member: entrySlug(person.id) },
		props: person,
	}));
}

type Props = CollectionEntry<'cv'>;

const person = Astro.props as Props;
const cv = person.data;
const locale = resolveLocale(Astro);
const t = useTranslations(locale);

const promoUrls = import.meta.glob('../../../assets/promos/*', {
	eager: true,
	query: '?url',
	import: 'default',
}) as Record<string, string>;
const assets = Object.fromEntries(
	Object.entries(promoUrls).map(([path, url]) => [path.split('/').pop()!, url]),
);
---

<PageLayout title={t('team.title')} description={cv.headline}>
	<section class="content-shell cv">
		<header class="cv__header">
			<figure class="cv__portrait">
				<Image src={cv.photo} alt={cv.name} width={440} height={440} />
			</figure>
			<div class="cv__identity">
				<h1 class="cv__name">{cv.name} <span class="cv__alt">({cv.altName})</span></h1>
				<p class="cv__headline">{cv.headline}</p>
				<ul class="cv__contacts">
					{cv.contacts.map((line) => (
						<li>
							{line.startsWith('http')
								? <a href={line} target="_blank" rel="noreferrer">{line.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a>
								: line.includes('@')
									? <a href={`mailto:${line}`}>{line}</a>
									: line}
						</li>
					))}
				</ul>
			</div>
			<div class="cv__pdf"><CvButton /></div>
		</header>

		{cv.sections.map((section) => (
			<section class="cv__section">
				<h2 class="cv__section-title">{section.title}</h2>
				<div class="cv__entries">
					{section.entries.map((entry) => (
						<div class="cv__entry">
							{entry.org && (
								<p class="cv__org">
									{entry.org}
									{entry.location && <span class="cv__location"> · {entry.location}</span>}
								</p>
							)}
							{entry.roles.map((role) => (
								<p class="cv__role">
									{entry.href
										? <a href={localeUrl(locale, entry.href)}>{role}</a>
										: <RichText text={role} assets={assets} />}
								</p>
							))}
							{entry.notes.map((note) => (
								<p class="cv__note"><RichText text={note} assets={assets} /></p>
							))}
						</div>
					))}
				</div>
			</section>
		))}

		<p class="cv__disclaimer">{t('team.disclaimer')}</p>
	</section>
</PageLayout>

<style>
	.cv {
		display: flex;
		flex-direction: column;
		gap: calc(var(--grid-cell) * 1);
		padding-block: var(--grid-cell) var(--grid-cell);
	}

	.cv__header {
		display: grid;
		grid-template-columns: calc(var(--grid-cell) * 3) 1fr auto;
		align-items: start;
		column-gap: var(--grid-cell);
		row-gap: 1.5rem;
	}

	.cv__portrait {
		margin: 0;
	}

	.cv__portrait :global(img) {
		width: 100%;
		border-radius: 18px;
		border: 1px solid var(--color-border);
		object-fit: cover;
	}

	.cv__identity {
		min-width: 0;
	}

	.cv__name {
		position: relative;
		top: var(--baseline-shift-half);
		margin: 0;
		font-size: clamp(1.75rem, 3.4vw, 2.5rem);
		font-weight: 600;
		line-height: calc(var(--grid-cell) / 2);
		color: var(--color-ink);
	}

	.cv__alt {
		color: var(--color-accent-soft);
		font-weight: 400;
		white-space: nowrap;
	}

	.cv__headline {
		margin: 0.75rem 0 0;
		max-width: 52rem;
		color: var(--color-muted);
		line-height: 1.65;
	}

	.cv__contacts {
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.25rem;
		font-size: 0.95rem;
		color: var(--color-muted);
	}

	.cv__pdf {
		justify-self: end;
	}

	.cv__section {
		display: grid;
		grid-template-columns: calc(var(--grid-cell) * 3) 1fr;
		column-gap: var(--grid-cell);
		row-gap: 0.75rem;
		align-items: start;
	}

	.cv__section-title {
		margin: 0;
		font-family: var(--font-header), serif;
		font-size: 0.72rem;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--color-accent-soft);
		padding-top: 0.35rem;
	}

	.cv__entries {
		display: grid;
		gap: 1.75rem;
		min-width: 0;
	}

	.cv__entry {
		min-width: 0;
	}

	.cv__org {
		margin: 0;
		font-weight: 600;
		color: var(--color-ink);
	}

	.cv__location {
		font-weight: 400;
		color: var(--color-muted);
	}

	.cv__role {
		margin: 0.15rem 0 0;
		color: var(--color-ink);
	}

	.cv__note {
		margin: 0.35rem 0 0;
		max-width: 52rem;
		color: var(--color-muted);
		line-height: 1.6;
		font-size: 0.97rem;
	}

	.cv__disclaimer {
		margin: 0;
		max-width: 52rem;
		font-size: 0.85rem;
		color: var(--tone-subtle);
	}

	@media (max-width: 860px) {
		.cv__header {
			grid-template-columns: calc(var(--grid-cell) * 2) 1fr;
		}

		.cv__pdf {
			grid-column: 1 / -1;
			justify-self: start;
		}

		.cv__section {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}
	}
</style>
