---
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import Values from '../../components/Values.astro';
import CvButton from '../../components/CvButton.astro';
import portrait from '../../assets/team/marklaptenok.jpg';
import { localePaths, resolveLocale, useTranslations } from '../../i18n/utils';

export const getStaticPaths = localePaths;

const locale = resolveLocale(Astro);
const t = useTranslations(locale);
---

<PageLayout title={t('team.title')} description={t('team.description')}>
	<section class="content-shell py-12 space-y-10">
		<div class="flex justify-end">
			<CvButton />
		</div>

		<div class="grid gap-8 md:grid-cols-[220px_1fr] md:items-start">
			<figure class="m-0 max-w-[220px]">
				<Image
					src={portrait}
					alt={t('team.photoAlt')}
					width={440}
					height={440}
					class="w-full rounded-2xl border border-[color:var(--color-border)] object-cover"
				/>
			</figure>
			<div class="space-y-4 max-w-3xl">
				<p class="eyebrow m-0">{t('team.eyebrow')}</p>
				<p class="text-ink text-2xl font-semibold leading-tight">{t('team.lead')}</p>
				<p class="text-muted">{t('team.body1')}</p>
				<p class="text-muted">{t('team.body2')}</p>
				<p class="text-muted">{t('team.body3')}</p>
			</div>
		</div>

		<blockquote class="m-0 border-l-2 border-[color:var(--color-border)] pl-5 text-xl text-ink">
			{t('team.motto')}
		</blockquote>
	</section>

	<div class="mt-4 md:mt-8">
		<Values
			useShell={false}
			eyebrow={t('focus.eyebrow')}
			title={t('focus.title')}
			copy={t('focus.copy')}
			values={[
				{ title: t('focus.systems.title'), description: t('focus.systems.description') },
				{ title: t('focus.people.title'), description: t('focus.people.description') },
				{ title: t('focus.kernel.title'), description: t('focus.kernel.description') },
				{ title: t('focus.teaching.title'), description: t('focus.teaching.description') },
			]}
		/>
	</div>

	<section class="content-shell">
		<p class="m-0 max-w-3xl text-sm text-subtle">{t('team.disclaimer')}</p>
	</section>
</PageLayout>
