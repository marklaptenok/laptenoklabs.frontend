---
import PageLayout from '../../layouts/PageLayout.astro';
import Card from '../../components/Card.astro';
import { getLocalizedCollection, localePaths, resolveLocale, useTranslations } from '../../i18n/utils';

export const getStaticPaths = localePaths;

const locale = resolveLocale(Astro);
const t = useTranslations(locale);

const team = (await getLocalizedCollection('authors', locale)).map((entry) => entry.data);
---

<PageLayout title={t('team.title')} description={t('team.description')}>
	<section class="content-shell py-12 space-y-8">
		<header class="space-y-3 max-w-3xl">
			<p class="text-xs uppercase tracking-[0.3em] text-subtle">{t('team.eyebrow')}</p>
			<h1 class="text-3xl sm:text-4xl font-semibold leading-tight text-ink">{t('team.heading')}</h1>
			<p class="text-base text-muted">{t('team.description')}</p>
		</header>

		{team.length === 0 ? (
			<p class="text-muted">{t('team.empty')}</p>
		) : (
			<div class="grid gap-6 md:grid-cols-3">
				{team.map((person) => (
					<Card
						title={person.name}
						eyebrow={person.role}
						description={person.bio}
						image={person.avatar}
						imageAlt={person.name}
					>
						<div class="mt-3 space-y-1 text-sm text-subtle">
							{person.location && <p class="m-0 font-medium text-muted">{person.location}</p>}
							{person.focus && <p class="m-0">{person.focus}</p>}
						</div>
					</Card>
				))}
			</div>
		)}
	</section>
</PageLayout>
