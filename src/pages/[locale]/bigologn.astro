---
import { type CollectionEntry, getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { entryLocale, resolveLocale, useTranslations } from '../../i18n/utils';
import { getSite } from '../../utils/consts';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects
		.filter((project) => project.data.url === '/bigologn')
		.map((project) => ({
			params: { locale: entryLocale(project.id) },
			props: project,
		}));
}

type Props = CollectionEntry<'projects'>;

const site = await getSite();
const project = Astro.props as Props;
const locale = resolveLocale(Astro);
const t = useTranslations(locale);
---

<PageLayout title={`${project.data.title} · ${site.title}`} description={project.data.description}>
	<section class="content-shell in-progress">
		<p class="in-progress__status">{t('projects.inProgress')}</p>
	</section>
</PageLayout>

<style>
	.in-progress {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 60vh;
		padding-block: clamp(3rem, 12vh, 7rem);
	}

	.in-progress__status {
		margin: 0;
		font-family: var(--font-header), serif;
		font-size: clamp(1.5rem, 4vw, 2.5rem);
		letter-spacing: 0.04em;
		color: var(--color-accent-soft);
		text-align: center;
	}
</style>
