---
import Card from '../../../components/Card.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import { getSite } from '../../../utils/consts';
import {
	entrySlug,
	getLocalizedCollection,
	localePaths,
	localeUrl,
	resolveLocale,
	useTranslations,
} from '../../../i18n/utils';

export const getStaticPaths = localePaths;

const locale = resolveLocale(Astro);
const t = useTranslations(locale);
const site = await getSite();

const posts = await getLocalizedCollection('articles', locale);
const [featured, ...rest] = posts;
---

<PageLayout title={`${t('articles.title')} · ${site.title}`} description={t('articles.description')} noindex={posts.length === 0}>
	<section class="content-shell py-12 space-y-8">
		<header class="space-y-2">
			<h1 class="text-4xl font-semibold text-ink">{t('articles.title')}</h1>
			<p class="text-muted">{t('articles.description')}</p>
		</header>

		{posts.length === 0 && <p class="text-muted">{t('articles.empty')}</p>}

		{featured && (
			<div class="grid grid-cols-1">
				<Card
					title={featured.data.title}
					href={localeUrl(locale, `/articles/${entrySlug(featured.id)}`)}
					description={featured.data.description}
					date={featured.data.pubDate}
					image={featured.data.heroImage}
					imageAlt={featured.data.title}
				>
					{featured.data.tags.length > 0 && (
						<div class="flex flex-wrap gap-2 pt-1 text-sm text-muted">
							{featured.data.tags.map((tag) => (
								<span class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-surface)] px-3 py-1 hover:text-ink">{tag}</span>
							))}
						</div>
					)}
				</Card>
			</div>
		)}

		{rest.length > 0 && (
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
				{rest.map((post) => (
					<Card
						title={post.data.title}
						href={localeUrl(locale, `/articles/${entrySlug(post.id)}`)}
						description={post.data.description}
						date={post.data.pubDate}
						image={post.data.heroImage}
						imageAlt={post.data.title}
					>
						{post.data.tags.length > 0 && (
							<div class="flex flex-wrap gap-2 pt-1 text-sm text-muted">
								{post.data.tags.map((tag) => (
									<span class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-surface)] px-3 py-1 hover:text-ink">{tag}</span>
								))}
							</div>
						)}
					</Card>
				))}
			</div>
		)}
	</section>
</PageLayout>
