---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import PostList from '../../components/PostList.astro';
import Numbers from '../../components/Numbers.astro';
import Values from '../../components/Values.astro';
import Technologies from '../../components/Technologies.astro';
import { getSite } from '../../utils/consts';
import { localePaths, resolveLocale, useTranslations } from '../../i18n/utils';

export const getStaticPaths = localePaths;

const locale = resolveLocale(Astro);
const t = useTranslations(locale);
const site = await getSite();
---

<PageLayout title={site.title} description={t('site.description')}>
	<Hero
		eyebrow={t('home.hero.eyebrow')}
		title={t('home.hero.title')}
		description={t('home.hero.description')}
		actions={[
			{ label: t('home.hero.actionArticles'), href: '/articles' },
			{ label: t('home.hero.actionTeam'), href: '/team' },
		]}
	/>

	<Technologies />

	<Values
		eyebrow={t('focus.eyebrow')}
		title={t('focus.title')}
		copy={t('focus.copy')}
		values={[
			{ title: t('focus.systems.title'), description: t('focus.systems.description') },
			{ title: t('focus.people.title'), description: t('focus.people.description') },
			{ title: t('focus.kernel.title'), description: t('focus.kernel.description') },
			{ title: t('focus.teaching.title'), description: t('focus.teaching.description') },
		]}
	/>

	<Numbers
		eyebrow={t('home.numbers.eyebrow')}
		title={t('home.numbers.title')}
		copy={t('home.numbers.copy')}
		stats={[
			{
				value: t('home.numbers.hours.value'),
				label: t('home.numbers.hours.label'),
				description: t('home.numbers.hours.description'),
			},
			{
				value: t('home.numbers.people.value'),
				label: t('home.numbers.people.label'),
				description: t('home.numbers.people.description'),
			},
			{
				value: t('home.numbers.since.value'),
				label: t('home.numbers.since.label'),
				description: t('home.numbers.since.description'),
			},
		]}
	/>

	<PostList limit={3} />
</PageLayout>
