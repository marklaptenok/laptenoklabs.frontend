---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import Numbers from '../../components/Numbers.astro';
import Services from '../../components/Services.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getSite } from '../../utils/consts';
import { localePaths, localeUrl, resolveLocale, useTranslations } from '../../i18n/utils';

export const getStaticPaths = localePaths;

const locale = resolveLocale(Astro);
const t = useTranslations(locale);
const site = await getSite();

const organization = {
	'@type': 'Organization',
	name: t('footer.company'),
	alternateName: site.title,
	url: new URL(localeUrl(locale, '/'), Astro.site).toString(),
	logo: new URL('/favicon.svg', Astro.site).toString(),
	email: t('contact.email'),
	telephone: t('contact.phone'),
	description: t('site.description'),
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Prosincová č.ev. 1583/12, Litice',
		postalCode: '321 00',
		addressLocality: 'Plzeň',
		addressCountry: 'CZ',
	},
	identifier: t('footer.ico'),
	knowsLanguage: ['en', 'ru', 'cs'],
};
---

<PageLayout title={`${site.title} — ${t('home.hero.eyebrow')}`} description={t('site.description')}>
	<JsonLd schema={organization} />
	<Hero
		eyebrow={t('home.hero.eyebrow')}
		title={t('home.hero.title')}
		highlights={[
			{ term: t('home.hero.lead1.term'), rest: t('home.hero.lead1.rest') },
			{ term: t('home.hero.lead2.term'), rest: t('home.hero.lead2.rest') },
			{ term: t('home.hero.lead3.term'), rest: t('home.hero.lead3.rest') },
			{ term: t('home.hero.lead4.term'), rest: t('home.hero.lead4.rest') },
		]}
		actions={[
			{ label: t('home.hero.actionLearning'), href: '/bigologn' },
			{ label: t('home.hero.actionProjects'), href: '/projects' },
		]}
	/>

	<Services
		eyebrow={t('services.eyebrow')}
		title={t('services.title')}
		copy={t('services.copy')}
		services={[
			{ title: t('services.one.title'), body: t('services.one.body') },
			{ title: t('services.two.title'), body: t('services.two.body') },
			{ title: t('services.three.title'), body: t('services.three.body') },
		]}
	/>

	<div class="pt-[calc(var(--grid-cell)*2)] pb-[calc(var(--grid-cell)*2)]">
		<Numbers
			eyebrow={t('home.numbers.eyebrow')}
			title={t('home.numbers.title')}
			copy={t('home.numbers.copy')}
			stats={[
				{
					value: t('home.numbers.hours.value'),
					label: t('home.numbers.hours.label'),
					description: t('home.numbers.hours.description'),
				},
				{
					value: t('home.numbers.people.value'),
					label: t('home.numbers.people.label'),
					description: t('home.numbers.people.description'),
				},
				{
					value: t('home.numbers.since.value'),
					label: t('home.numbers.since.label'),
					description: t('home.numbers.since.description'),
				},
			]}
		/>
	</div>
</PageLayout>
