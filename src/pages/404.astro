---
import PageLayout from '../layouts/PageLayout.astro';
import { locales, localeTags } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

const defaultAddress = 'customercare@laptenoklabs.com';

const messages = locales.map((locale) => {
	const [before, after] = useTranslations(locale)('notFound.message').split('{email}');
	return { lang: localeTags[locale], before, after };
});

const title = useTranslations('en')('notFound.title');
---

<PageLayout title={title} description={title}>
	<section class="content-shell not-found">
		{messages.map((message, i) => (
			<p
				class:list={['not-found__message', i > 0 && 'not-found__message--secondary']}
				lang={message.lang}
			>
				{message.before}<a class="contact-email" href={`mailto:${defaultAddress}`}>{defaultAddress}</a>{message.after}
			</p>
		))}
	</section>
</PageLayout>

<script is:inline>
	(() => {
		const host = location.hostname.replace(/^www\./, '');
		const tld = host.split('.').pop();
		if (!tld || host === tld || !/^[a-z]{2,}$/i.test(tld)) return;
		const address = 'customercare@laptenoklabs.' + tld.toLowerCase();
		document.querySelectorAll('.contact-email').forEach((node) => {
			node.textContent = address;
			node.setAttribute('href', 'mailto:' + address);
		});
	})();
</script>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.9rem;
		min-height: 48vh;
		padding-block: clamp(3rem, 12vh, 7rem);
	}

	.not-found__message {
		margin: 0;
		max-width: 46rem;
		font-size: clamp(1.1rem, 2.4vw, 1.5rem);
		line-height: 1.6;
		color: var(--color-ink);
	}

	.not-found__message--secondary {
		font-size: clamp(0.95rem, 1.8vw, 1.1rem);
		color: var(--color-muted);
	}
</style>
