---
import { formatDate, resolveLocale } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
	date: Date;
	locale?: Locale;
}

const { date, locale: localeProp } = Astro.props as Props;
const locale = localeProp ?? resolveLocale(Astro);
---

<time datetime={date.toISOString()}>{formatDate(date, locale)}</time>
