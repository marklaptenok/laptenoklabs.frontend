---
import type { HTMLAttributes } from 'astro/types';
import { localeUrl, resolveLocale } from '../i18n/utils';

type Props = Omit<HTMLAttributes<'a'>, 'href'> & {
	href: string;
	activeClass?: string;
};

const { href, class: className, activeClass = 'text-ink font-semibold', ...props } = Astro.props;

const locale = resolveLocale(Astro);
const resolved = localeUrl(locale, href);

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = pathname === resolved || pathname.startsWith(`${resolved}/`);
---

<a
	href={resolved}
	class:list={[className, isActive && activeClass]}
	aria-current={isActive ? 'page' : undefined}
	{...props}
>
	<slot />
</a>
