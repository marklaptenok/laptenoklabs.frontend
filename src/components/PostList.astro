---
import Card from "./Card.astro";
import {
  entrySlug,
  getLocalizedCollection,
  localeUrl,
  resolveLocale,
  useTranslations,
} from "../i18n/utils";

export interface Props {
  heading?: string;
  eyebrow?: string;
  copy?: string;
  limit?: number;
  viewAllHref?: string;
  viewAllLabel?: string;
}

const locale = resolveLocale(Astro);
const t = useTranslations(locale);

const {
  heading = t("blog.heading"),
  eyebrow = t("blog.eyebrow"),
  copy = t("blog.description"),
  limit = 6,
  viewAllHref = "/blog",
  viewAllLabel = t("blog.viewAll"),
} = Astro.props as Props;

const posts = await getLocalizedCollection("blog", locale);
const visiblePosts = typeof limit === "number" ? posts.slice(0, limit) : posts;
---

<section>
  <div>
    <div class="grid grid-cols-1 border-base-200">
      <header class="space-y-2 max-w-2xl lg:pb-12">
        <p class="eyebrow m-0">{eyebrow}</p>
        <h2 class="text-3xl sm:text-4xl font-semibold leading-tight text-ink m-0">
          {heading}
        </h2>
        <p class="text-muted m-0">{copy}</p>
      </header>
      <div class="lg:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-y-20 gap-x-8">
        {
          visiblePosts.map((post) => (
            <Card
              title={post.data.title}
              href={localeUrl(locale, `/blog/${entrySlug(post.id)}`)}
              image={post.data.heroImage}
              imageAlt={post.data.title}
              description={post.data.description}
              date={post.data.pubDate}
            />
          ))
        }
        <Card title={viewAllLabel} href={localeUrl(locale, viewAllHref)} />
      </div>
    </div>
  </div>
</section>
