---
interface Stat {
  label: string;
  value: string;
  description?: string;
  delta?: string;
}

interface Props {
  title?: string;
  eyebrow?: string;
  copy?: string;
  stats?: Stat[];
}

const { title, eyebrow, copy, stats = [] } = Astro.props as Props;
---

<section class="numbers-section">
  <header class="numbers-header max-w-4xl">
    {eyebrow && <p class="eyebrow numbers-eyebrow">{eyebrow}</p>}
    {title && <h2 class="section-title">{title}</h2>}
    {copy && <p class="numbers-copy">{copy}</p>}
  </header>

  {stats.length > 0 && (
    <div class="numbers-grid">
      {stats.map((stat) => (
        <div class="rounded-2xl border border-border bg-surface px-5 py-6">
          <div class="flex items-baseline gap-2">
            <p class="text-3xl sm:text-4xl font-semibold tracking-tight text-ink m-0">{stat.value}</p>
            {stat.delta && <span class="text-xs font-semibold text-muted uppercase tracking-[0.12em]">{stat.delta}</span>}
          </div>
          <p class="text-sm uppercase tracking-[0.22em] text-muted m-0 mt-2">{stat.label}</p>
          {stat.description && <p class="text-sm text-muted m-0 mt-2">{stat.description}</p>}
        </div>
      ))}
    </div>
  )}
</section>

<style>
  .numbers-section {
    display: flex;
    flex-direction: column;
  }

  .numbers-header {
    display: grid;
    grid-template-rows: var(--grid-cell) calc(var(--grid-cell) * 2) calc(var(--grid-cell) * 2);
  }

  .numbers-eyebrow {
    position: relative;
    top: var(--baseline-shift);
    margin: 0;
    line-height: var(--grid-cell);
  }

  .numbers-header :global(.section-title) {
    align-self: end;
    top: var(--baseline-shift-half);
    line-height: calc(var(--grid-cell) / 2);
  }

  .numbers-copy {
    position: relative;
    top: var(--baseline-shift-step);
    align-self: start;
    margin: 0;
    padding-top: var(--baseline-step);
    max-width: 52rem;
    font-size: clamp(0.89rem, 1.62vw, 1.02rem);
    line-height: var(--baseline-step);
    color: var(--color-muted);
  }

  .numbers-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 1100px) {
    .numbers-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .numbers-section {
      gap: var(--grid-cell);
    }

    .numbers-header {
      display: flex;
      flex-direction: column;
      gap: calc(var(--grid-cell) / 2);
    }

    .numbers-header :global(.section-title) {
      align-self: stretch;
      top: 0;
      line-height: 1.2;
    }

    .numbers-copy {
      align-self: stretch;
      top: 0;
      padding-top: 0;
      line-height: 1.6;
    }

    .numbers-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
