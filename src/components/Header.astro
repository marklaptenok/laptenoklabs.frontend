---
import { getSite } from "../utils/consts";
import HeaderLink from "./HeaderLink.astro";
import SearchModal from "./SearchModal.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { Icon } from "astro-icon/components";
import { localeUrl, resolveLocale, useTranslations } from "../i18n/utils";

const site = await getSite();
const locale = resolveLocale(Astro);
const t = useTranslations(locale);
const homeHref = localeUrl(locale, "/");

const productLogos: Record<string, string> = { "/bigologn": "O(log n)" };
const section = "/" + (Astro.url.pathname.split("/").filter(Boolean)[1] ?? "");
const productLogo = productLogos[section];
---

<header class="site-header">
  <div class="content-shell">
    <div class="site-header__bar">
      <h1 class="site-title">
        <a href={homeHref}>{site.title}</a>
        {productLogo && <span class="site-title__product">{productLogo}</span>}
      </h1>

      <div class="site-header__actions">
        <SearchModal />
        <LanguageSwitcher />
        <button
          class="header-button"
          type="button"
          id="debug-toggle"
          aria-label={t('header.debug')}
          aria-pressed="false"
        >
          <Icon name="tabler:bug" size={18} stroke-width={1.6} />
        </button>
      </div>

      <nav id="primary-nav" class="site-nav" aria-label={t('nav.primary')}>
        <HeaderLink href="/articles">{t('nav.articles')}</HeaderLink>
        <HeaderLink href="/projects">{t('nav.projects')}</HeaderLink>
        <HeaderLink href="/team">{t('nav.team')}</HeaderLink>
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  const DEBUG_KEY = "debug-borders";

  const applyDebug = (state) => {
    const isOn = state === "on";
    document.documentElement.dataset.debug = isOn ? "on" : "off";
    const button = document.getElementById("debug-toggle");
    if (button) button.setAttribute("aria-pressed", isOn ? "true" : "false");
  };

  const getPreferredDebug = () => {
    const stored = localStorage.getItem(DEBUG_KEY);
    if (stored === "on" || stored === "off") return stored;
    return "off";
  };

  const toggleDebug = () => {
    const current =
      document.documentElement.dataset.debug === "on" ? "on" : "off";
    const next = current === "on" ? "off" : "on";
    localStorage.setItem(DEBUG_KEY, next);
    applyDebug(next);
  };

  applyDebug(getPreferredDebug());

  const debugButton = document.getElementById("debug-toggle");
  if (debugButton) {
    debugButton.addEventListener("click", toggleDebug);
  }
</script>

<style>
  @reference "tailwindcss";

  .site-header {
	position: fixed;
	inset-inline: 0;
	top: 0;
	z-index: 30;
	min-height: calc(var(--grid-cell) * 2);
	display: flex;
	align-items: center;
	background: color-mix(in oklab, var(--color-surface) 80%, transparent);
	-webkit-backdrop-filter: blur(14px);
	backdrop-filter: blur(14px);
  }

  .site-header__bar {
	display: grid;
	grid-template-columns: auto 1fr auto;
	grid-template-areas: "title nav actions";
	align-items: center;
	column-gap: 1.5rem;
	row-gap: 0.35rem;
	width: 100%;
	padding-block: 0.6rem;
  }

  .site-title {
	grid-area: title;
	margin: 0;
	min-width: 0;
	display: flex;
	align-items: baseline;
	flex-wrap: wrap;
	gap: 2em;
	font-family: var(--font-title), var(--font-header), serif;
	font-size: clamp(1.05rem, 3.2vw, 1.35rem);
	font-weight: 400;
	line-height: 1.05;
	letter-spacing: 0.01em;
  }

  .site-title a {
	color: var(--color-ink);
	text-decoration: none;
	display: inline-block;
	overflow-wrap: break-word;
  }

  .site-title__product {
	color: var(--color-accent);
	white-space: nowrap;
  }

  .site-header__actions {
	grid-area: actions;
	display: flex;
	align-items: center;
	gap: 1.5rem;
	flex-shrink: 0;
	justify-self: end;
  }

  .site-nav {
	grid-area: nav;
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 0.75rem;
	min-width: 0;
	font-size: 0.72rem;
	letter-spacing: 0.24em;
	text-transform: uppercase;
	color: var(--color-muted);
	white-space: nowrap;
  }

  .site-nav :global(a) {
	white-space: nowrap;
  }

  @media (max-width: 860px) {
	.site-header {
		min-height: calc(var(--grid-cell) * 3);
	}

	.site-header__bar {
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas:
			"title actions"
			"nav   nav";
		row-gap: 0.5rem;
	}

	.site-nav {
		justify-content: flex-start;
		gap: 0.9rem;
		overflow-x: auto;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
	}

	.site-nav::-webkit-scrollbar {
		display: none;
	}
  }

  @media (max-width: 400px) {
	.site-header__actions {
		gap: 1.05rem;
	}
  }
</style>
