---
import { getSite } from '../utils/consts';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Clock from './Clock.astro';
import { formatLocales } from '../i18n/config';
import { localeUrl, resolveLocale, useTranslations } from '../i18n/utils';
import type { TranslationKey } from '../i18n/ui';

const site = await getSite();
const locale = resolveLocale(Astro);
const t = useTranslations(locale);

const today = new Date();
const socials = (await getCollection('socials')).map((entry) => entry.data);
const iconMap: Record<string, string> = {
  x: 'tabler:brand-x',
  twitter: 'tabler:brand-x',
  github: 'tabler:brand-github',
  linkedin: 'tabler:brand-linkedin',
  email: 'tabler:mail',
  mastodon: 'tabler:brand-mastodon',
};

const socialLabel = (id: string | undefined, fallback: string) => {
  if (!id) return fallback;
  const key = `social.${id.toLowerCase()}` as TranslationKey;
  const translated = t(key);
  return translated === key ? fallback : translated;
};

const navLinks: Array<{ key: TranslationKey; href: string }> = [
  { key: 'nav.home', href: '/' },
  { key: 'nav.articles', href: '/articles' },
  { key: 'nav.team', href: '/team' },
  { key: 'nav.rss', href: '/rss.xml' },
];
---

<footer class="border-t border-[color:var(--color-border)] bg-[color:var(--color-surface)] py-8">
  <div class="content-shell">
    <div class="grid gap-10 border-b border-[color:var(--color-border)] pb-10 md:grid-cols-2">
        <div class="grid gap-3">
          <p class="text-3xl sm:text-4xl font-semibold tracking-tight text-ink">{t('footer.connect')}</p>
          <div class="grid gap-2 sm:grid-cols-2 text-sm text-ink">
            {socials.map((social) => {
              const iconName = social.id ? iconMap[social.id.toLowerCase()] : undefined;
              const label = socialLabel(social.id, social.label);
              const fallback = label?.trim()?.[0]?.toUpperCase() ?? '?';
              return (
                <a
                  href={social.href}
                  target={social.href.startsWith('http') ? '_blank' : undefined}
                  rel={social.href.startsWith('http') ? 'noreferrer' : undefined}
                  class="flex items-center gap-2 rounded-md px-2 py-1 transition-colors hover:text-ink hover:bg-[color:color-mix(in_oklab,var(--color-ink)_3%,transparent)]"
                >
                  {iconName ? (
                    <Icon
                      name={iconName}
                      size={18}
                      strokeWidth={1.5}
                      class="text-ink"
                      aria-hidden={true}
                    />
                  ) : (
                    <span class="inline-flex h-[26px] w-[26px] items-center justify-center rounded-full border border-[color:var(--color-border)] text-[0.7rem] font-semibold text-ink" aria-hidden="true">{fallback}</span>
                  )}
                  <span class="leading-tight">{label}</span>
                </a>
              );
            })}
          </div>
        </div>
        <div class="grid gap-3">
          <p class="text-3xl sm:text-4xl font-semibold tracking-tight text-ink">{t('footer.navigation')}</p>
          <div class="grid gap-2 sm:grid-cols-2 text-sm text-ink">
            {navLinks.map((link) => (
              <a class="transition-colors hover:text-ink" href={localeUrl(locale, link.href)}>{t(link.key)}</a>
            ))}
          </div>
        </div>
    </div>
    <div class="grid gap-6 pt-8 pb-4 md:flex md:items-center md:justify-between">
      <p class="text-sm text-ink m-0">{site.title} &copy; {today.getFullYear()}. {t('footer.rights')}</p>
      <div class="md:text-right space-y-2 md:space-y-1">
        <div class="flex flex-wrap items-center gap-3 md:justify-end">
          <p class="text-2xl sm:text-3xl font-semibold tracking-tight text-ink m-0">{t('footer.based')}</p>
          <Clock
            timeZone={site.timezone ? site.timezone : "UTC"}
            locale={formatLocales[locale]}
            hour12={false}
            showSeconds={false}
          />
        </div>
        <p class="text-sm text-muted m-0">{t('footer.colophon')}</p>
      </div>
    </div>
  </div>
</footer>
