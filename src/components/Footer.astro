---
import { getSite } from '../utils/consts';
import { Icon } from 'astro-icon/components';
import { localeUrl, resolveLocale, useTranslations } from '../i18n/utils';
import type { TranslationKey } from '../i18n/ui';

const site = await getSite();
const locale = resolveLocale(Astro);
const t = useTranslations(locale);

const today = new Date();

const contacts: Array<{ icon: string; key: TranslationKey; href?: string }> = [
  { icon: 'tabler:mail', key: 'contact.email', href: `mailto:${t('contact.email')}` },
  { icon: 'tabler:phone', key: 'contact.phone', href: `tel:${t('contact.phone').replace(/[^\d+]/g, '')}` },
  { icon: 'tabler:clock', key: 'contact.hours' },
];

const navLinks: Array<{ key: TranslationKey; href: string }> = [
  { key: 'nav.home', href: '/' },
  { key: 'nav.team', href: '/team' },
  { key: 'nav.articles', href: '/articles' },
  { key: 'nav.projects', href: '/projects' },
  { key: 'nav.rss', href: '/rss.xml' },
];
---

<footer class="site-footer">
  <div class="content-shell footer-inner">
    <div class="footer-columns">
      <div class="footer-column">
        <p class="footer-heading">{t('footer.connect')}</p>
        <div class="footer-list">
          {contacts.map((contact) => {
            const label = t(contact.key);
            return contact.href ? (
              <a href={contact.href} class="footer-item">
                <Icon name={contact.icon} size={18} strokeWidth={1.5} class="text-ink" aria-hidden={true} />
                <span class="leading-tight">{label}</span>
              </a>
            ) : (
              <p class="footer-item m-0">
                <Icon name={contact.icon} size={18} strokeWidth={1.5} class="text-ink" aria-hidden={true} />
                <span class="leading-tight">{label}</span>
              </p>
            );
          })}
        </div>
      </div>
      <div class="footer-column">
        <p class="footer-heading">{t('footer.navigation')}</p>
        <div class="footer-list">
          {navLinks.map((link) => (
            <a class="footer-item" href={localeUrl(locale, link.href)}>{t(link.key)}</a>
          ))}
        </div>
      </div>
    </div>

    <div class="footer-meta">
      <p class="text-sm text-ink m-0">{site.title} &copy; {today.getFullYear()}. {t('footer.rights')}</p>
      <p class="text-sm text-muted m-0">{t('footer.colophon')}</p>
      <address class="not-italic footer-address">
        <p class="text-sm text-ink m-0">{t('footer.company')}</p>
        <p class="text-sm text-muted m-0">{t('footer.ico')}</p>
        <p class="text-sm text-muted m-0">{t('footer.address')}</p>
        <p class="text-sm text-muted m-0">{t('footer.registry')}</p>
      </address>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: color-mix(in oklab, var(--color-surface) 80%, var(--color-paper));
    border-top: 1px solid var(--color-border);
    padding-block: 2rem 1rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    justify-content: space-between;
    gap: 2.5rem 4rem;
  }

  .footer-columns {
    flex: 0 0 auto;
  }

  .footer-meta {
    flex: 0 1 auto;
    min-width: 0;
  }

  .footer-columns {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 4rem;
  }

  .footer-column {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .footer-heading {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-accent-soft);
  }

  .footer-list {
    display: grid;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-ink);
  }

  .footer-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.25rem;
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    text-align: right;
  }

  .footer-address {
    display: grid;
    gap: 0.15rem;
    margin-top: auto;
  }

  @media (max-width: 860px) {
    .footer-inner {
      flex-direction: column;
      flex-wrap: wrap;
      gap: 2.5rem;
    }

    .footer-address {
      margin-top: 0;
    }
  }

  @media (max-width: 640px) {
    .footer-meta {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
