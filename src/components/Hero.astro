---
interface Action {
	label: string;
	href: string;
}

interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	actions?: Action[];
}

import { localeUrl, resolveLocale } from '../i18n/utils';

const { eyebrow, title, description, actions = [] } = Astro.props;
const locale = resolveLocale(Astro);
---

<section class="content-shell flex items-center">
	<div class="grid gap-4 max-w-3xl">
		{eyebrow && <p class="eyebrow">{eyebrow}</p>}
		<h1 class="hero-title leading-tight m-0">{title}</h1>
		{description && <p class="text-muted text-base md:text-lg max-w-2xl m-0">{description}</p>}
		{actions.length > 0 && (
			<div class="flex flex-wrap gap-3 mt-3">
				{actions.map((action) => (
					<a class="button primary" href={localeUrl(locale, action.href)}>
						{action.label}
					</a>
				))}
			</div>
		)}
	</div>
</section>

<style>
	.hero-title {
		font-size: clamp(1.75rem, 8.2vw, 3.75rem);
		overflow-wrap: break-word;
	}

	.content-shell {
		min-height: calc(100vh - max(calc(var(--grid-cell) * 1), 4.5rem));
	}

	@media (max-width: 860px) {
		.content-shell {
			min-height: calc(100vh - max(calc(var(--grid-cell) * 2), 6.5rem));
		}
	}
</style>
