---
interface Action {
	label: string;
	href: string;
}

interface Highlight {
	term: string;
	rest: string;
}

interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	highlights?: Highlight[];
	actions?: Action[];
}

import { localeUrl, resolveLocale } from '../i18n/utils';

const { eyebrow, title, description, highlights = [], actions = [] } = Astro.props;
const locale = resolveLocale(Astro);
---

<section class="content-shell hero-shell" data-hero>
	<div class="hero-stack">
		{eyebrow && <p class="eyebrow hero-eyebrow">{eyebrow}</p>}
		<h1 class="hero-title m-0">{title}</h1>
		{description && <p class="hero-description text-muted m-0">{description}</p>}
		{highlights.length > 0 && (
			<p class="hero-lead m-0">
				{highlights.map((highlight) => (
					<>
						<strong class="hero-lead__term">{highlight.term}</strong>
						<span class="hero-lead__rest">{highlight.rest}</span>
						{' '}
					</>
				))}
			</p>
		)}
		{actions.length > 0 && (
			<div class="hero-actions">
				{actions.map((action, i) => (
					<a class:list={['button', i === 0 ? 'primary' : 'secondary']} href={localeUrl(locale, action.href)}>
						{action.label}
					</a>
				))}
			</div>
		)}
	</div>
</section>

<style>
	.hero-shell {
		display: flex;
		align-items: flex-start;
		margin-top: calc(var(--grid-cell) * -1);
		padding-top: 0;
		padding-bottom: var(--grid-cell);
		min-height: calc(100vh - var(--grid-cell));
	}

	@supports (height: round(down, 10px, 3px)) {
		.hero-shell {
			min-height: round(down, calc(100vh - var(--grid-cell)), var(--grid-cell));
		}
	}

	.hero-stack {
		display: flex;
		flex-direction: column;
		width: 100%;
	}

	.hero-eyebrow {
		position: relative;
		top: var(--baseline-shift);
		margin: 0;
		line-height: var(--grid-cell);
	}

	.hero-title {
		position: relative;
		top: var(--baseline-shift);
		font-size: calc(var(--grid-cell) * 0.7);
		line-height: var(--grid-cell);
		overflow-wrap: break-word;
		margin-block: var(--grid-cell) 0;
	}

	.hero-description,
	.hero-lead {
		position: relative;
		top: var(--baseline-shift-step);
		margin-block: var(--grid-cell) 0;
		max-width: calc(var(--grid-cell) * 10);
		height: var(--grid-cell);
		font-size: clamp(1rem, 2.1vw, 1.25rem);
		line-height: var(--baseline-step);
	}

	.hero-lead__term {
		color: var(--color-accent-soft);
		font-weight: 600;
	}

	.hero-lead__rest {
		color: var(--color-muted);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 0.75rem;
		height: var(--grid-cell);
	}

	@media (max-width: 1100px) {
		.hero-title {
			font-size: calc(var(--grid-cell) * 0.5);
		}
	}

	@media (max-width: 860px) {
		.hero-shell {
			margin-top: 0;
			padding-top: var(--grid-cell);
		}

		.hero-eyebrow {
			top: var(--baseline-shift-half);
			height: calc(var(--grid-cell) * 2);
			line-height: calc(var(--grid-cell) / 2);
		}

		.hero-description,
		.hero-lead {
			height: calc(var(--grid-cell) * 3);
		}

		.hero-actions {
			height: calc(var(--grid-cell) * 2);
		}
	}
</style>
