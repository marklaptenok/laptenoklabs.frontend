---
interface Action {
	label: string;
	href: string;
}

interface Highlight {
	term: string;
	rest: string;
}

interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	highlights?: Highlight[];
	actions?: Action[];
}

import { localeUrl, resolveLocale } from '../i18n/utils';

const { eyebrow, title, description, highlights = [], actions = [] } = Astro.props;
const locale = resolveLocale(Astro);
---

<section class="content-shell hero-shell">
	<div class="hero-stack max-w-3xl">
		{eyebrow && <p class="eyebrow hero-eyebrow">{eyebrow}</p>}
		<h1 class="hero-title m-0">{title}</h1>
		{description && <p class="text-muted text-base md:text-lg max-w-2xl m-0">{description}</p>}
		{highlights.length > 0 && (
			<p class="hero-lead max-w-2xl m-0">
				{highlights.map((highlight) => (
					<>
						<strong class="hero-lead__term">{highlight.term}</strong>
						<span class="hero-lead__rest">{highlight.rest}</span>
						{' '}
					</>
				))}
			</p>
		)}
		{actions.length > 0 && (
			<div class="hero-actions">
				{actions.map((action, i) => (
					<a class:list={['button', i === 0 ? 'primary' : 'secondary']} href={localeUrl(locale, action.href)}>
						{action.label}
					</a>
				))}
			</div>
		)}
	</div>
</section>

<style>
	.hero-shell {
		display: flex;
		align-items: flex-start;
		padding-top: calc(var(--grid-cell) * 2);
	}

	.hero-stack {
		display: flex;
		flex-direction: column;
	}

	.hero-eyebrow {
		position: relative;
		top: var(--baseline-shift);
		margin: 0;
		line-height: var(--grid-cell);
	}

	.hero-title {
		position: relative;
		top: var(--baseline-shift);
		font-size: var(--grid-cell);
		line-height: 1;
		overflow-wrap: break-word;
		margin-block: var(--grid-cell) 0;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 0.75rem;
		height: calc(var(--grid-cell) * 2);
	}

	.hero-lead {
		margin-block: var(--grid-cell) 0;
		font-size: clamp(1rem, 2.1vw, 1.25rem);
		line-height: calc(var(--grid-cell) / 2);
	}

	.hero-lead__term {
		color: var(--color-accent-soft);
		font-weight: 600;
	}

	.hero-lead__rest {
		color: var(--color-muted);
	}

	.hero-shell {
		min-height: calc(100vh - var(--grid-cell) * 2);
		padding-bottom: var(--grid-cell);
	}
</style>
