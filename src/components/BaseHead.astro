---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-about.png';
import { getSite } from '../utils/consts';
import { SEO } from 'astro-seo';
import { localeTags } from '../i18n/config';
import { alternateUrls, localeUrl, resolveLocale } from '../i18n/utils';

const site = await getSite();

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	noindex?: boolean;
}

const { title, description, image = FallbackImage, noindex = false } = Astro.props;

const locale = resolveLocale(Astro);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL((image as ImageMetadata).src, Astro.site ?? Astro.url);

const alternates = await alternateUrls(Astro.url.pathname, Astro.site);
const rssHref = new URL(localeUrl(locale, '/rss.xml'), Astro.site ?? Astro.url).toString();
---

<SEO
	charset="utf-8"
	noindex={noindex}
	title={title}
	description={description}
	canonical={canonicalURL.toString()}
	openGraph={{
		basic: {
			title,
			type: 'website',
			image: imageURL.toString(),
			url: canonicalURL.toString(),
		},
		optional: {
			description,
			siteName: site.title,
			locale: localeTags[locale],
		},
	}}
	twitter={{
		card: 'summary_large_image',
		title,
		description,
		image: imageURL.toString(),
		imageAlt: title,
	}}
		extend={{
		link: [
			{ rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
			{ rel: 'sitemap', href: '/sitemap-index.xml' },
			{ rel: 'alternate', type: 'application/rss+xml', title: site.title, href: rssHref },
			...alternates.map((alt) => ({
				rel: 'alternate',
				hreflang: alt.hreflang,
				href: alt.href,
			})),
		],
		meta: [
			{ name: 'viewport', content: 'width=device-width,initial-scale=1' },
			{ name: 'generator', content: Astro.generator },
		],
	}}
/>
