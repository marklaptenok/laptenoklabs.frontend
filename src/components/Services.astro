---
interface Service {
	title: string;
	body?: string;
}

interface Props {
	eyebrow?: string;
	title?: string;
	copy?: string;
	services?: Service[];
}

const { eyebrow, title, copy, services = [] } = Astro.props as Props;
---

<section class="space-y-8">
	<header class="space-y-3 max-w-4xl">
		{eyebrow && <p class="eyebrow m-0">{eyebrow}</p>}
		{title && <h2 class="section-title">{title}</h2>}
		{copy && <p class="services__copy m-0">{copy}</p>}
	</header>

	{services.length > 0 && (
		<ol class="services">
			{services.map((service) => (
				<li class="services__item">
					<h3 class="services__name">{service.title}</h3>
					{service.body && <p class="services__body">{service.body}</p>}
				</li>
			))}
		</ol>
	)}
</section>

<style>
	.services__copy {
		max-width: 52rem;
		font-size: clamp(0.89rem, 1.7vw, 1.11rem);
		line-height: 1.65;
		color: var(--color-muted);
	}

	.services {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2rem;
	}

	.services__item {
		min-width: 0;
	}

	.services__name {
		margin: 0;
		font-size: clamp(1.15rem, 2.4vw, 1.6rem);
		font-weight: 600;
		line-height: 1.25;
		color: var(--color-ink);
		text-wrap: balance;
	}

	.services__body {
		margin: 0.5rem 0 0;
		max-width: 52rem;
		font-size: clamp(0.89rem, 1.62vw, 1.02rem);
		line-height: 1.65;
		color: var(--color-muted);
	}
</style>
