---
interface Service {
	title: string;
	body?: string;
}

interface Props {
	eyebrow?: string;
	title?: string;
	copy?: string;
	services?: Service[];
}

const { eyebrow, title, copy, services = [] } = Astro.props as Props;
---

<section class="services-section">
	<header class="services-header max-w-4xl">
		{eyebrow && <p class="eyebrow m-0">{eyebrow}</p>}
		{title && <h2 class="section-title">{title}</h2>}
		{copy && <p class="services__copy m-0">{copy}</p>}
	</header>

	{services.length > 0 && (
		<ol class="services">
			{services.map((service) => (
				<li class="services__item">
					<h3 class="services__name">{service.title}</h3>
					{service.body && <p class="services__body">{service.body}</p>}
				</li>
			))}
		</ol>
	)}
</section>

<style>
	.services-section {
		display: flex;
		flex-direction: column;
	}

	.services-header {
		display: grid;
		grid-template-rows: calc(var(--grid-cell) * 2) var(--grid-cell) var(--grid-cell);
	}

	.services-header :global(.eyebrow) {
		position: relative;
		top: var(--baseline-shift);
		align-self: end;
		margin: 0;
		line-height: var(--grid-cell);
	}

	.services-header :global(.section-title) {
		align-self: end;
		top: var(--baseline-shift-half);
		line-height: calc(var(--grid-cell) / 2);
	}

	.services__copy {
		position: relative;
		top: var(--baseline-shift-step);
		align-self: start;
		margin: 0;
		padding-top: var(--baseline-step);
		max-width: 52rem;
		font-size: clamp(0.89rem, 1.7vw, 1.11rem);
		line-height: var(--baseline-step);
		color: var(--color-muted);
	}

	.services {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0;
	}

	.services__item {
		min-width: 0;
		display: grid;
		grid-template-rows: var(--grid-cell) var(--grid-cell);
	}

	.services__name {
		position: relative;
		top: var(--baseline-shift-half);
		align-self: end;
		margin: 0;
		font-size: clamp(1rem, 2.2vw, 1.25rem);
		font-weight: 600;
		line-height: calc(var(--grid-cell) / 2);
		color: var(--color-ink);
		text-wrap: balance;
	}

	.services__body {
		position: relative;
		top: var(--baseline-shift-step);
		align-self: start;
		margin: 0;
		padding-top: var(--baseline-step);
		max-width: 52rem;
		font-size: clamp(0.89rem, 1.62vw, 1.02rem);
		line-height: var(--baseline-step);
		color: var(--color-muted);
	}

	@media (max-width: 860px) {
		.services-section {
			gap: var(--grid-cell);
		}

		.services-header :global(.eyebrow) {
			align-self: stretch;
		}

		.services-header,
		.services__item {
			display: flex;
			flex-direction: column;
			gap: calc(var(--grid-cell) / 2);
		}

		.services-header :global(.section-title) {
			align-self: stretch;
			top: 0;
			line-height: 1.2;
		}

		.services__name {
			align-self: stretch;
			top: 0;
			line-height: 1.25;
		}

		.services__copy,
		.services__body {
			align-self: stretch;
			top: 0;
			padding-top: 0;
			line-height: 1.6;
		}

		.services {
			gap: var(--grid-cell);
		}
	}
</style>
